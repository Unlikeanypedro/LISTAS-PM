public class Aluno {

    String nome;
    int idade;
    int coragem;
    int inteligencia;
    int ambicao;
    int lealdade;
    int estrategia;
    int criatividade;
    String casa;

    void exibirInformacoes() {

        System.out.println("\n===== INFORMAÇÕES DO ALUNO =====");
        System.out.println("Nome: " + nome);
        System.out.println("Idade: " + idade);
        System.out.println("Coragem: " + coragem);
        System.out.println("Inteligência: " + inteligencia);
        System.out.println("Ambição: " + ambicao);
        System.out.println("Lealdade: " + lealdade);
        System.out.println("Estratégia: " + estrategia);
        System.out.println("Criatividade: " + criatividade);
        System.out.println("Casa: " + casa);
    }

    String calcularCasa() {
        int[] valores = new int[4];
        
        valores[0] = (2 * coragem) + lealdade;
        valores[1] = (2 * ambicao) + estrategia;
        valores[2] = (2 * inteligencia) + criatividade;
        valores[3] = ((2 * lealdade) + coragem) / 3;

        int maiorValor = valores[0];
        int posValor = 0;

        for (int i = 1; i < valores.length; i++) {

            if (valores[i] > maiorValor) {
                maiorValor = valores[i];
                posValor = i;
            }
        }

        if (posValor == 0) {
            casa = "Grifinória";

        } else if (posValor == 1) {
            casa = "Sonserina";

        } else if (posValor == 2) {
            casa = "Corvinal";

        } else {
            casa = "Lufa-Lufa";
        }

        return casa;
    }
}
